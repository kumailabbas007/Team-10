
let teamRegistration;

async function enableTeamNotifications() {
  const status = document.getElementById("notificationStatus");

  if (!("Notification" in window) ||
      !("serviceWorker" in navigator)) {
    status.textContent = "Browser notifications unsupported.";
    return;
  }

  try {
    const permission = await Notification.requestPermission();

    if (permission !== "granted") {
      status.textContent = "Notification permission not granted.";
      return;
    }

    teamRegistration =
      await navigator.serviceWorker.register("./sw.js");

    await navigator.serviceWorker.ready;

    status.textContent = "Notifications: ENABLED";

    await teamRegistration.showNotification(
      "TEAM ALERT CENTER",
      { body: "Android notifications are enabled!" }
    );

  } catch (error) {
    status.textContent = "Setup failed. Please retry.";
  }
}

async function sendTestAlert() {
  if (Notification.permission !== "granted") {
    alert("Enable notifications first.");
    return;
  }

  try {
    teamRegistration =
      teamRegistration ||
      await navigator.serviceWorker.ready;

    await teamRegistration.showNotification(
      "TEAM GOLD ALERT",
      {
        body: "Test notification received! XAUUSD alert integration is next.",
        tag: "team-test-alert"
      }
    );
  } catch (error) {
    alert("Could not send notification.");
  }
}
